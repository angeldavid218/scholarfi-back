# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000,https://scholarfi.netlify.app

#--------------------------------------------------------------------
# Credits / token execution (mock = demo DB ledger, solana = devnet custodial)
#--------------------------------------------------------------------
TOKEN_MODE=mock

# Required when TOKEN_MODE=solana
# SOLANA_RPC_URL=https://api.devnet.solana.com
# SCHOLARFI_TOKEN_MINT=
# MINT_AUTHORITY_SECRET=
# TREASURY_WALLET_PUBLIC_KEY=
# WALLET_ENCRYPTION_KEY=

#--------------------------------------------------------------------
# PostgreSQL (when using config/database.ts pg connection)
#--------------------------------------------------------------------
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_DATABASE=scholarfi