# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

#--------------------------------------------------------------------
# Database (PostgreSQL — default connection in config/database.ts)
#--------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_DATABASE=scholarfi

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# Include your local Vite URL when NODE_ENV=production locally or when using VITE_API_URL.
# CORS_ORIGIN=http://localhost:5173,https://scholarfi.netlify.app

#--------------------------------------------------------------------
# Google Classroom integration (optional — required for connector endpoints)
# See docs/google-classroom-setup.md for GCP console steps.
#--------------------------------------------------------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3333/api/v1/integrations/google-classroom/callback
# GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/classroom.courses.readonly,https://www.googleapis.com/auth/classroom.rosters.readonly,https://www.googleapis.com/auth/classroom.coursework.students.readonly,https://www.googleapis.com/auth/classroom.profile.emails,https://www.googleapis.com/auth/userinfo.email
# INTEGRATION_TOKEN_ENCRYPTION_KEY=
# FRONTEND_URL=http://localhost:5173
# GOOGLE_CLASSROOM_MOCK=false
# Default password assigned when Sync students provisions Classroom roster accounts
# CLASSROOM_STUDENT_DEFAULT_PASSWORD=scholarfi-pass

# @adonisjs/queue — database (default) requires `npm run queue:work` alongside the API.
# Use sync only for tests / debugging (processes jobs inline in the HTTP process).
# QUEUE_DRIVER=database
# Nightly Classroom "sync all" (grades/rewards). Registered on API boot; worker dispatches it.
# CLASSROOM_NIGHTLY_SYNC_CRON=0 2 * * *
# CLASSROOM_NIGHTLY_SYNC_TIMEZONE=America/Mexico_City

#--------------------------------------------------------------------
# Credits / token execution (mock = demo DB ledger, solana = devnet custodial)
#--------------------------------------------------------------------
TOKEN_MODE=mock

# Required when TOKEN_MODE=solana
# SOLANA_RPC_URL=https://api.devnet.solana.com
# SCHOLARFI_TOKEN_MINT=
# MINT_AUTHORITY_SECRET=
# TREASURY_WALLET_PUBLIC_KEY=
# WALLET_ENCRYPTION_KEY=

#--------------------------------------------------------------------
# School score leaderboard POC (node ace school-score:devnet)
#--------------------------------------------------------------------
# LEADERBOARD_PROGRAM_ID=
# LEADERBOARD_ORACLE_SECRET=   # JSON byte array or bs58; falls back to MINT_AUTHORITY_SECRET

#--------------------------------------------------------------------
# SAS attestation POC (node ace sas:setup / sas:attest)
#--------------------------------------------------------------------
# SAS_ENABLED=true
# SAS_CREDENTIAL_NAME=
# SAS_SCHEMA_NAME=
# SAS_SCHEMA_VERSION=1
# SAS_CREDENTIAL_PDA=
# SAS_SCHEMA_PDA=
# SAS_MILESTONE_SCHEMA_NAME=scholarfi.milestone.v1
# SAS_MILESTONE_SCHEMA_VERSION=1
# SAS_MILESTONE_SCHEMA_PDA=
# SAS_AUTHORITY_SECRET=        # credential admin; falls back to authorized signer
# SAS_AUTHORIZED_SIGNER_SECRET=  # falls back to LEADERBOARD_ORACLE_SECRET then MINT_AUTHORITY_SECRET
# SAS_ATTESTATION_EXPIRY_DAYS=365

# Milestone attestations run off-sync: node ace sas:attest-milestones
# (MVP: Logro completado — 5 primeras actividades)

#--------------------------------------------------------------------
# PostgreSQL (when using config/database.ts pg connection)
#--------------------------------------------------------------------
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_DATABASE=scholarfi